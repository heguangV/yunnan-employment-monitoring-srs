#!/bin/sh
set -eu
task_repo_root=$(git rev-parse --show-toplevel)
if command -v python >/dev/null 2>&1 && python -c 'import sys; assert sys.version_info >= (3, 10)' >/dev/null 2>&1; then
  task_python=python
elif command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; assert sys.version_info >= (3, 10)' >/dev/null 2>&1; then
  task_python=python3
else
  printf '%s\n' 'Python 3.10 or newer is required to validate staged project files.' >&2
  exit 1
fi
"$task_python" "$task_repo_root/SRS工作文件/check_repo.py"
