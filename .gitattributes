# Normalize text in Git; Windows command files use CRLF on checkout.
* text=auto
*.md text eol=lf
*.typ text eol=lf whitespace=-blank-at-eof
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

*.pdf binary
*.docx binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
